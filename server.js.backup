// server.js (versão COMPLETA e DESCOMENTADA)
const express = require('express');
const { Resend } = require('resend');
const cors = require('cors');
const { createClient } = require('@supabase/supabase-js');
require('dotenv').config();
const path = require('path');

const app = express();
const resend = new Resend(process.env.RESEND_API_KEY);
const PORT = process.env.PORT || 10000;

// --- CORREÇÃO DA URL DO SUPABASE ---
let supabaseUrl = process.env.SUPABASE_URL || '';

// Remove qualquer caminho extra da URL
supabaseUrl = supabaseUrl.replace(/\/rest\/v1.*$/, '');
supabaseUrl = supabaseUrl.replace(/\/api.*$/, '');
supabaseUrl = supabaseUrl.replace(/\/+$/, '');

console.log('✅ URL do Supabase (corrigida):', supabaseUrl);

// Verifica se a URL é válida
try {
    new URL(supabaseUrl);
} catch (err) {
    console.error('❌ URL do Supabase inválida:', supabaseUrl);
    process.exit(1);
}

// Inicializa Supabase
const supabase = createClient(
    supabaseUrl,
    process.env.SUPABASE_ANON_KEY
);

console.log('✅ Cliente Supabase inicializado');

// Middlewares
app.use(cors());
app.use(express.json({ limit: '50mb' }));
app.use(express.urlencoded({ extended: true, limit: '50mb' }));
app.use(express.static(path.join(__dirname, 'public')));

// Middleware de log
app.use((req, res, next) => {
    console.log(`📨 ${req.method} ${req.url}`);
    next();
});

const ETAPAS = {
    formulario_enviado: { label: 'Formulário Enviado', description: 'Cliente enviou o formulário inicial.' },
    analise_correcoes: { label: 'Análise e Correções', description: 'Documentos em análise ou aguardando correções.' },
    abertura_processo: { label: 'Abertura de Processo', description: 'Processo iniciado formalmente.' },
    boleto_emitido: { label: 'Boleto Emitido', description: 'Boleto de pagamento gerado.' },
    boleto_pago: { label: 'Boleto Pago', description: 'Pagamento do boleto confirmado.' },
    agendamento_realizado: { label: 'Agendamento Realizado', description: 'Agendamento de entrevista ou serviço.' },
    treinamento_realizado: { label: 'Treinamento Realizado', description: 'Treinamento para entrevista concluído.' },
    entrevista_realizada: { label: 'Entrevista Realizada', description: 'Entrevista com o consulado/órgão realizada.' },
    visto_aprovado: { label: 'Visto Aprovado', description: 'Visto aprovado.' },
    passaporte_retornado: { label: 'Passaporte Retornado', description: 'Passaporte com visto retornado ao cliente.' },
    visto_recusado: { label: 'Visto Recusado', description: 'Visto recusado.' },
    processo_finalizado: { label: 'Processo Finalizado', description: 'Processo concluído (aprovado ou recusado).' }
};

// --- TESTE DE CONEXÃO ---
async function testarConexao() {
    try {
        console.log('🔍 Testando conexão com Supabase...');
        
        const { data, error } = await supabase
            .from('clientes_ativos')
            .select('*')
            .limit(1);
        
        if (error) {
            console.warn('⚠️ Erro ao acessar clientes_ativos:', error.message);
            console.log('💡 As tabelas ainda não foram criadas no banco de dados.');
            console.log('   Execute os comandos SQL no SQL Editor do Supabase para criar as tabelas.');
        } else {
            console.log('✅ Conexão com Supabase bem-sucedida!');
            console.log(`   Tabela clientes_ativos: ${data ? data.length : 0} registros`);
        }
    } catch (err) {
        console.error('❌ Erro no teste:', err.message);
    }
}

// --- ROTA DO DASHBOARD (COMPLETA E DESCOMENTADA) ---
app.get('/api/dashboard-data', async (req, res) => {
    try {
        console.log('📊 Iniciando busca de dados do dashboard...');

        const responseData = {
            message: 'Dados do Dashboard',
            serverStatus: 'Online',
            onlineUsers: 0,
            newRegistrationsToday: 0,
            pendingTasks: 0,
            recentActivities: [],
            lastUpdate: new Date().toLocaleString('pt-BR'),
            warnings: []
        };

        // 1. CONTAR USUÁRIOS ONLINE (clientes_ativos)
        try {
            const { count: onlineUsersCount, error: activeError } = await supabase
                .from('clientes_ativos')
                .select('*', { count: 'exact', head: true });

            if (activeError) {
                responseData.warnings.push(`clientes_ativos: ${activeError.message}`);
            } else {
                responseData.onlineUsers = onlineUsersCount || 0;
                console.log('✅ clientes_ativos:', responseData.onlineUsers);
            }
        } catch (err) {
            responseData.warnings.push(`clientes_ativos: ${err.message}`);
        }

        // 2. CONTAR NOVOS REGISTROS (clientes_novos)
        try {
            const today = new Date();
            today.setHours(0, 0, 0, 0);
            const tomorrow = new Date(today);
            tomorrow.setDate(today.getDate() + 1);

            const { count: newRegistrationsCount, error: newRegError } = await supabase
                .from('clientes_novos')
                .select('*', { count: 'exact', head: true })
                .gte('data_contato', today.toISOString())
                .lt('data_contato', tomorrow.toISOString());

            if (newRegError) {
                responseData.warnings.push(`clientes_novos: ${newRegError.message}`);
            } else {
                responseData.newRegistrationsToday = newRegistrationsCount || 0;
                console.log('✅ clientes_novos:', responseData.newRegistrationsToday);
            }
        } catch (err) {
            responseData.warnings.push(`clientes_novos: ${err.message}`);
        }

        // 3. CONTAR TAREFAS PENDENTES (etapas_processo)
        try {
            const pendingStages = [
                'formulario_enviado',
                'analise_correcoes',
                'abertura_processo',
                'boleto_emitido',
                'boleto_pago',
                'agendamento_realizado'
            ];
            
            const { data: pendingTasksData, error: pendingError } = await supabase
                .from('etapas_processo')
                .select('id')
                .in('etapa_atual', pendingStages);

            if (pendingError) {
                responseData.warnings.push(`etapas_processo: ${pendingError.message}`);
            } else {
                responseData.pendingTasks = pendingTasksData ? pendingTasksData.length : 0;
                console.log('✅ etapas_processo:', responseData.pendingTasks);
            }
        } catch (err) {
            responseData.warnings.push(`etapas_processo: ${err.message}`);
        }

        // 4. ATIVIDADES RECENTES - AGORA DESCOMENTADO E FUNCIONANDO
        try {
            console.log('📊 Buscando atividades recentes...');
            
            const { data: recentActivities, error: activitiesError } = await supabase
                .from('etapas_processo')
                .select('cliente_telefone, etapa_atual, data_atualizacao, historico')
                .order('data_atualizacao', { ascending: false })
                .limit(5);

            if (activitiesError) {
                console.warn('⚠️ Erro em atividades recentes:', activitiesError.message);
                responseData.warnings.push(`atividades_recentes: ${activitiesError.message}`);
            } else if (recentActivities && recentActivities.length > 0) {
                responseData.recentActivities = recentActivities.map(activity => {
                    const etapaInfo = ETAPAS[activity.etapa_atual];
                    const etapaLabel = etapaInfo ? etapaInfo.label : activity.etapa_atual;
                    const lastHistoryEntry = activity.historico && activity.historico.length > 0
                        ? activity.historico[activity.historico.length - 1]
                        : null;
                    const note = lastHistoryEntry ? lastHistoryEntry.nota : 'Atualização de etapa';

                    return {
                        time: new Date(activity.data_atualizacao).toLocaleString('pt-BR'),
                        description: `Cliente ${activity.cliente_telefone} - ${etapaLabel}: ${note}`
                    };
                });
                console.log('✅ Atividades recentes carregadas:', responseData.recentActivities.length);
            } else {
                console.log('ℹ️ Nenhuma atividade recente encontrada');
                responseData.recentActivities = [];
            }
        } catch (err) {
            console.warn('⚠️ Falha ao buscar atividades recentes:', err.message);
            responseData.warnings.push(`atividades_recentes: ${err.message}`);
        }

        // Verificar se houve avisos
        if (responseData.warnings.length > 0) {
            responseData.message = 'Dados carregados com avisos';
            console.log('⚠️ Avisos:', responseData.warnings);
        } else {
            responseData.message = 'Dados carregados com sucesso!';
            console.log('✅ Dashboard completo!');
        }

        res.json(responseData);

    } catch (error) {
        console.error('❌ Erro no dashboard:', error);
        res.status(500).json({
            message: 'Erro ao carregar dados',
            error: error.message,
            serverStatus: 'Offline',
            onlineUsers: 0,
            newRegistrationsToday: 0,
            pendingTasks: 0,
            recentActivities: [],
            lastUpdate: new Date().toLocaleString('pt-BR')
        });
    }
});

// --- ROTA DE CONTATO ---
app.post('/api/contact-form', async (req, res) => {
    const { name, email, message } = req.body;

    console.log('📧 Mensagem de Contato Recebida:');
    console.log(`Nome: ${name}`);
    console.log(`Email: ${email}`);
    console.log(`Mensagem: ${message}`);

    try {
        // Enviar e-mail para a equipe
        await resend.emails.send({
            from: 'GetVisa <contato@getvisa.com.br>',
            to: ['getvisa.assessoria@gmail.com'],
            subject: `Nova Mensagem de Contato de ${name} (Painel GetVisa)`,
            html: `
                <p>Você recebeu uma nova mensagem de contato do painel:</p>
                <p><strong>Nome:</strong> ${name}</p>
                <p><strong>Email:</strong> ${email}</p>
                <p><strong>Mensagem:</strong> ${message}</p>
            `
        });
        console.log('✅ E-mail de contato enviado para a equipe com sucesso!');

        // Enviar e-mail de confirmação para o cliente
        await resend.emails.send({
            from: 'GetVisa <contato@getvisa.com.br>',
            to: [email],
            subject: 'Confirmação de Recebimento - Sua Mensagem para GetVisa',
            html: `
                <p>Olá ${name},</p>
                <p>Recebemos sua mensagem através do nosso painel de contato.</p>
                <p>Nossa equipe entrará em contato com você em breve.</p>
                <p>Agradecemos seu interesse!</p>
                <p>Atenciosamente,</p>
                <p>Equipe GetVisa</p>
            `
        });
        console.log('✅ E-mail de confirmação enviado para o cliente com sucesso!');

        res.status(200).json({ message: 'Mensagem enviada com sucesso! Um e-mail de confirmação foi enviado.' });
    } catch (error) {
        console.error('❌ Erro ao enviar e-mail com Resend:', error);
        res.status(500).json({ message: 'Erro ao enviar mensagem. Tente novamente mais tarde.' });
    }
});

// --- ROTA DE DIAGNÓSTICO ---
app.get('/api/check-connection', async (req, res) => {
    try {
        const info = {
            supabaseUrl: supabaseUrl,
            urlCorrected: true,
            connectionTest: false,
            tablesFound: [],
            error: null
        };
        
        // Testar conexão com clientes_ativos
        const { data, error } = await supabase
            .from('clientes_ativos')
            .select('*')
            .limit(1);
        
        if (error) {
            info.connectionTest = false;
            info.error = error.message;
            info.message = 'Conexão OK, mas tabela clientes_ativos não encontrada. Crie as tabelas no Supabase.';
        } else {
            info.connectionTest = true;
            info.message = 'Conexão bem-sucedida!';
            info.tablesFound.push('clientes_ativos');
        }
        
        // Testar clientes_novos
        const { error: error2 } = await supabase
            .from('clientes_novos')
            .select('*')
            .limit(1);
        
        if (!error2) {
            info.tablesFound.push('clientes_novos');
        }
        
        // Testar etapas_processo
        const { error: error3 } = await supabase
            .from('etapas_processo')
            .select('*')
            .limit(1);
        
        if (!error3) {
            info.tablesFound.push('etapas_processo');
        }
        
        res.json(info);
    } catch (error) {
        res.status(500).json({ error: error.message });
    }
});

// Rota para receber dados do formulário DS-160
app.post('/api/submit-ds160', async (req, res) => {
    try {
        const {
            fullName,
            email,
            phone,
            birthDate,
            birthPlace,
            nationality,
            passportNumber,
            issueDate,
            expirationDate,
            visaType,
            travelDate,
            travelPurpose,
            previousVisas,
            deniedVisas,
            usContact,
            usContactPhone,
            usContactEmail,
            address,
            city,
            state,
            zipCode,
            emergencyContactName,
            emergencyContactPhone,
            emergencyContactEmail,
            signature,
            submissionDate,
            ds160Data // Dados do formulário DS-160 em JSON
        } = req.body;

        // Validação básica
        if (!fullName || !email || !phone || !ds160Data) {
            return res.status(400).json({ message: 'Dados obrigatórios faltando.' });
        }

        // 1. Salvar os dados do formulário DS-160 no Supabase
        const { data: newDS160, error: ds160Error } = await supabase
            .from('ds160_forms') // Certifique-se de que esta tabela existe no Supabase
            .insert([
                {
                    full_name: fullName,
                    email: email,
                    phone: phone,
                    birth_date: birthDate,
                    birth_place: birthPlace,
                    nationality: nationality,
                    passport_number: passportNumber,
                    issue_date: issueDate,
                    expiration_date: expirationDate,
                    visa_type: visaType,
                    travel_date: travelDate,
                    travel_purpose: travelPurpose,
                    previous_visas: previousVisas,
                    denied_visas: deniedVisas,
                    us_contact: usContact,
                    us_contact_phone: usContactPhone,
                    us_contact_email: usContactEmail,
                    address: address,
                    city: city,
                    state: state,
                    zip_code: zipCode,
                    emergency_contact_name: emergencyContactName,
                    emergency_contact_phone: emergencyContactPhone,
                    emergency_contact_email: emergencyContactEmail,
                    signature: signature,
                    submission_date: submissionDate,
                    ds160_data: ds160Data // Salva o JSON completo
                }
            ]);

        if (ds160Error) {
            console.error('❌ Erro ao salvar DS-160 no Supabase:', ds160Error);
            throw ds160Error;
        }
        console.log('✅ Dados do formulário DS-160 salvos no Supabase:', newDS160);

        // 2. Enviar e-mail de confirmação com Resend
        const { data: emailData, error: emailError } = await resend.emails.send({
            from: 'Seu Nome <onboarding@resend.dev>', // Altere para o seu domínio verificado no Resend
            to: [email], // Envia para o e-mail do cliente
            subject: 'Confirmação de Recebimento do Formulário DS-160',
            html: `
                <p>Olá ${fullName},</p>
                <p>Recebemos com sucesso o seu formulário DS-160. Agradecemos por preencher!</p>
                <p>Em breve, nossa equipe entrará em contato para dar andamento ao seu processo.</p>
                <p>Detalhes do seu envio:</p>
                <ul>
                    <li>Nome Completo: ${fullName}</li>
                    <li>E-mail: ${email}</li>
                    <li>Telefone: ${phone}</li>
                    <li>Tipo de Visto Desejado: ${visaType}</li>
                </ul>
                <p>Atenciosamente,</p>
                <p>Sua Equipe de Vistos</p>
            `,
        });

        if (emailError) {
            console.error('❌ Erro ao enviar e-mail com Resend:', emailError);
            // Não vamos lançar o erro aqui para não impedir a resposta de sucesso do formulário,
            // mas é importante logar e monitorar.
        } else {
            console.log('✅ E-mail de confirmação enviado com sucesso:', emailData);
        }

        res.status(200).json({
            message: 'Formulário DS-160 recebido e e-mail de confirmação enviado com sucesso!',
            data: newDS160
        });

    } catch (error) {
        console.error('❌ Erro no processamento do formulário DS-160:', error);
        res.status(500).json({
            message: 'Erro ao processar o formulário DS-160.',
            error: error.message
        });
    }
});

// Rota para o webhook da Z-API
// --- WEBHOOK Z-API CORRIGIDO (substitua a rota existente) ---
// Rota para o webhook da Z-API - CORRIGIDO
app.post('/api/webhook/zapi', async (req, res) => {
    try {
        const event = req.body;
        console.log('📨 WEBHOOK Z-API CORRIGIDO');
        console.log('📨 Body:', JSON.stringify(event, null, 2));

        // Processar mensagem recebida
        if (event.type === 'ReceivedCallback' && event.text && event.text.message) {
            const mensagem = event.text.message;
            const telefoneBruto = event.phone || event.chatLid;
            
            // Limpar telefone (remover 55, espaços, etc)
            let telefoneLimpo = telefoneBruto.replace(/\D/g, '');
            if (telefoneLimpo.startsWith('55')) {
                telefoneLimpo = telefoneLimpo.substring(2);
            }
            
            console.log(`📱 Telefone limpo: ${telefoneLimpo}`);
            console.log(`💬 Mensagem: "${mensagem}"`);

            // 1. VERIFICAR SE O CLIENTE EXISTE - USANDO O CAMPO CORRETO
            let cliente = null;
            
            // Verificar em clientes_ativos (usando 'telefone' em vez de 'cliente_telefone')
            const { data: clienteAtivo, error: errorAtivo } = await supabase
                .from('clientes_ativos')
                .select('*')
                .eq('telefone', telefoneLimpo)  // <- MUDANÇA AQUI
                .maybeSingle();
            
            if (clienteAtivo) {
                cliente = clienteAtivo;
                console.log('✅ Cliente encontrado em clientes_ativos');
            } else {
                // Verificar em clientes_novos (usando 'telefone')
                const { data: clienteNovo, error: errorNovo } = await supabase
                    .from('clientes_novos')
                    .select('*')
                    .eq('telefone', telefoneLimpo)  // <- MUDANÇA AQUI
                    .maybeSingle();
                
                if (clienteNovo) {
                    cliente = clienteNovo;
                    console.log('✅ Cliente encontrado em clientes_novos');
                }
            }

            // 2. SE NÃO EXISTIR, CRIAR NOVO CLIENTE
            if (!cliente) {
                console.log('🆕 Criando novo cliente...');
                
                // Usando os campos CORRETOS da tabela
                const novoCliente = {
                    telefone: telefoneLimpo,  // <- MUDANÇA AQUI (era cliente_telefone)
                    nome: event.senderName || 'Cliente WhatsApp',
                    data_contato: new Date().toISOString(),
                    status: 'novo',
                    onboarding_completo: false
                    // updated_at NÃO é incluído porque o banco já tem valor padrão
                };
                
                console.log('📝 Dados do novo cliente:', novoCliente);
                
                const { data: inserted, error: insertError } = await supabase
                    .from('clientes_novos')
                    .insert([novoCliente])
                    .select();
                
                if (insertError) {
                    console.error('❌ Erro ao inserir cliente:', insertError);
                    
                    // Tenta sem o campo status se houver erro
                    if (insertError.message.includes('status')) {
                        delete novoCliente.status;
                        const { data: retryData, error: retryError } = await supabase
                            .from('clientes_novos')
                            .insert([novoCliente])
                            .select();
                        
                        if (retryError) {
                            console.error('❌ Erro ao inserir cliente (tentativa 2):', retryError);
                        } else {
                            console.log('✅ Cliente criado com sucesso (sem status)');
                            cliente = retryData[0];
                        }
                    }
                } else {
                    console.log('✅ Cliente criado com sucesso!');
                    console.log('📊 Dados inseridos:', inserted);
                    cliente = inserted[0];
                }
            }

            // 3. SALVAR MENSAGEM (opcional)
            if (cliente) {
                try {
                    const { error: msgError } = await supabase
                        .from('mensagens_whatsapp')
                        .insert([{
                            telefone: telefoneLimpo,  // <- MUDANÇA AQUI
                            mensagem: mensagem,
                            direcao: 'recebida',
                            data_envio: new Date().toISOString()
                        }]);
                    
                    if (msgError) {
                        console.warn('⚠️ Erro ao salvar mensagem:', msgError.message);
                    } else {
                        console.log('✅ Mensagem salva com sucesso');
                    }
                } catch (err) {
                    console.warn('⚠️ Erro ao salvar mensagem (tabela pode não existir):', err.message);
                }
            }

            // 4. RESPONDER AUTOMATICAMENTE (opcional)
            try {
                const zapiInstance = process.env.ZAPI_INSTANCE_ID || '3F1D4E0F2AD0539F0C52B20DE66F3711';
                const zapiToken = process.env.ZAPI_TOKEN;
                const zapiClientToken = process.env.ZAPI_CLIENT_TOKEN;
                
                if (zapiToken && zapiClientToken) {
                    console.log('📨 Enviando resposta automática...');
                }
            } catch (err) {
                console.warn('⚠️ Erro ao enviar resposta automática:', err.message);
            }

        } else {
            console.log('ℹ️ Evento ignorado:', event.type || 'tipo desconhecido');
        }

        res.status(200).send('OK');

    } catch (error) {
        console.error('❌ Erro no webhook Z-API:', error);
        res.status(500).json({ error: error.message });
    }
});

// --- ROTAS ADICIONAIS ---
